# ==========================================================================
#  MODELO DE CONFIGURAÇÃO DO BACK-END (mesmos nomes do projeto Desempenho de Rotas)
#
#  Local (sua máquina): copie este arquivo para backend/.env e preencha.
#  Nuvem (GitHub Actions): cadastre os MESMOS nomes em
#    Settings > Secrets and variables > Actions
#      - Secrets: todas (repositório público: só Secrets aparecem como *** no log)
#  Variáveis já definidas no ambiente têm prioridade sobre este arquivo.
#  Valores entre aspas simples para que $ ! | não sejam interpretados.
# ==========================================================================

# --- SAP Datasphere (OAuth Client "Technical User" / Client Credentials) ---
DATASPHERE_TENANT_URL='https://SEU-TENANT.us10.hcs.cloud.sap'
DATASPHERE_TOKEN_URL='https://SEU-TENANT.authentication.us10.hana.ondemand.com/oauth/token'
DATASPHERE_CLIENT_ID='cole-aqui-o-client-id'
DATASPHERE_CLIENT_SECRET='cole-aqui-o-secret'

# --- Modelo de origem ---
DATASPHERE_SPACE='DW_BND_COM_SAP'
DATASPHERE_ASSET='AM_FAT_BND_ANALISE_META'

# --- Opcionais ---
# Pasta onde a API é gravada (relativa a backend/); os arquivos ficam em <pasta>/v1/
SAIDA_DIR='../api'
# Janela de horário (Brasília) em que o gerador roda sem --forcar
JANELA_EXECUCAO='07:00-18:59'
# Tempo máximo (s) por resposta do Datasphere e consultas simultâneas
ODATA_TIMEOUT=300
ODATA_MAX_WORKERS=6
